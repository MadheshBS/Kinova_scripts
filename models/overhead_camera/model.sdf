<?xml version="1.0"?>
<sdf version="1.7">
  <model name="overhead_camera">
    <static>true</static>
    <link name="camera_link">
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.0000001</ixx><iyy>0.0000001</iyy><izz>0.0000001</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>

      <sensor name="overhead_rgbd" type="rgbd_camera">
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <visualize>true</visualize>
        <topic>overhead_camera</topic>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>5.0</far>
          </clip>
        </camera>
      </sensor>
    </link>
  </model>
</sdf>