<?xml version="1.0"?>
<sdf version="1.7">
  <model name="simple_table">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry>
          <box><size>0.4 0.4 0.4</size></box>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <box><size>0.4 0.4 0.4</size></box>
        </geometry>
        <material>
          <ambient>0.5 0.35 0.2 1</ambient>
          <diffuse>0.5 0.35 0.2 1</diffuse>
        </material>
      </visual>

      <!-- Cosmetic place-slot markers (visual-only, no collision).
           Desaturated on purpose: pale tints instead of pure R/G/B so they
           fall well outside the cube detector's HSV thresholds (S >= 100).
           Still visually distinguishable as red/green/blue-tinted slots. -->
      <visual name="marker_red">
        <pose>0.15 -0.1 0.201 0 0 0</pose>
        <geometry>
          <box><size>0.05 0.05 0.002</size></box>
        </geometry>
        <material>
          <ambient>0.9 0.75 0.75 1</ambient>
          <diffuse>0.9 0.75 0.75 1</diffuse>
        </material>
      </visual>

      <visual name="marker_green">
        <pose>0.15 0.0 0.201 0 0 0</pose>
        <geometry>
          <box><size>0.05 0.05 0.002</size></box>
        </geometry>
        <material>
          <ambient>0.75 0.9 0.75 1</ambient>
          <diffuse>0.75 0.9 0.75 1</diffuse>
        </material>
      </visual>

      <visual name="marker_blue">
        <pose>0.15 0.1 0.201 0 0 0</pose>
        <geometry>
          <box><size>0.05 0.05 0.002</size></box>
        </geometry>
        <material>
          <ambient>0.75 0.75 0.9 1</ambient>
          <diffuse>0.75 0.75 0.9 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>